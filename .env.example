# --- Allgemein ---
APP_ENV=development
SECRET_KEY=change-me-please-32-chars-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Datenbank ---
# Produktion (Docker): postgresql+psycopg://reporting:reporting@db:5432/reporting
# Dev-Fallback (ohne Postgres): sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://reporting:reporting@db:5432/reporting

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Verschlüsselung der gespeicherten OAuth-Tokens (Fernet-Key) ---
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Google Ads API (für echte Daten; leer = Demo-Adapter) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Content API / Merchant Center ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- PageSpeed Insights (optional, für technisches SEO) ---
PAGESPEED_API_KEY=

# --- Datenquelle erzwingen: "demo" oder "live" (leer = auto) ---
DATA_SOURCE_MODE=demo
