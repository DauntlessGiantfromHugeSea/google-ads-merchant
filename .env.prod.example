# Produktions-Konfiguration für north-flow.de
# Kopieren nach .env.prod und Werte setzen. NIEMALS committen!

# Domain (für Caddy/HTTPS). www optional separat in der Caddyfile ergänzen.
DOMAIN=north-flow.de

APP_ENV=production

# Sicherheits-Keys (zwingend setzen!)
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   CREDENTIAL_ENCRYPTION_KEY (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Datenbank-Passwort (frei wählbar, stark)
POSTGRES_PASSWORD=

# Google-APIs werden pro Kunde im Tool hinterlegt – hier nichts nötig.
DATA_SOURCE_MODE=

# Optional: PageSpeed-API-Key für technisches SEO
PAGESPEED_API_KEY=

# Öffentliche Basis-URL (für OAuth-Redirects), z.B. https://north-flow.de
PUBLIC_BASE_URL=https://north-flow.de

# Microsoft 365 / Outlook (E-Mail senden). Azure-App-Registrierung nötig:
# Redirect-URI dort: https://north-flow.de/api/mail/callback
# Scopes: Mail.Send, Mail.Read (fuer Posteingang-Abgleich der Konversationen), User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# NorthLab Control Panel (panel.north-lab.de) – WordPress-Verwaltung per Webhook.
#   NORTHLAB_PANEL_SECRET: geteiltes Secret für die HMAC-Signatur der Webhooks
#     (im Panel identisch hinterlegen). Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   NORTHLAB_PANEL_TOKEN: Bearer-Token für die Abruf-API des Panels (Erstimport/Recovery)
NORTHLAB_PANEL_SECRET=
NORTHLAB_PANEL_TOKEN=
NORTHLAB_PANEL_URL=https://panel.north-lab.de

# Verschlüsseltes Cloud-Backup zur Hetzner Storage Box (stündlich, SFTP via rclone crypt).
# Leer lassen = kein Upload. BACKUP_CRYPT_PASSWORD ist Pflicht, sobald
# HETZNER_SFTP_HOST gesetzt ist – ohne Schlüssel wird NICHT hochgeladen.
# Der Schlüssel bleibt NUR hier auf dem Server; NIEMALS mit in die Storage Box
# laden (sonst ist die Verschlüsselung wertlos). Sicher notieren – ohne ihn ist
# ein Cloud-Backup nicht wiederherstellbar!
#   Host/User stehen in der Hetzner-Konsole (z. B. u123456.your-storagebox.de / u123456),
#   SFTP-Port der Storage Box ist 23.
HETZNER_SFTP_HOST=
HETZNER_SFTP_USER=
HETZNER_SFTP_PASS=
HETZNER_SFTP_PORT=23
HETZNER_REMOTE_PATH=northflow-backups
HETZNER_KEEP_HOURS=720
#   BACKUP_CRYPT_PASSWORD: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_CRYPT_PASSWORD=
# Backup-Takt in Sekunden (3600 = stündlich) und lokale Aufbewahrung (Anzahl Dumps).
BACKUP_INTERVAL=3600
KEEP_DAILY=72

# Rechnungs-/RE-Funktionen nur aus dem Tailscale-Netz erlauben (true/false).
# Kunden nutzen north-flow.de weiter öffentlich; nur das RE-Senden ist geschützt.
TAILSCALE_GUARD=false
