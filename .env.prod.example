# Produktions-Konfiguration für north-flow.de
# Kopieren nach .env.prod und Werte setzen. NIEMALS committen!

# Domain (für Caddy/HTTPS). www optional separat in der Caddyfile ergänzen.
DOMAIN=north-flow.de

APP_ENV=production

# Sicherheits-Keys (zwingend setzen!)
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   CREDENTIAL_ENCRYPTION_KEY (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Datenbank-Passwort (frei wählbar, stark)
POSTGRES_PASSWORD=

# Google-APIs werden pro Kunde im Tool hinterlegt – hier nichts nötig.
DATA_SOURCE_MODE=

# Optional: PageSpeed-API-Key für technisches SEO
PAGESPEED_API_KEY=

# Öffentliche Basis-URL (für OAuth-Redirects), z.B. https://north-flow.de
PUBLIC_BASE_URL=https://north-flow.de

# Microsoft 365 / Outlook (E-Mail senden). Azure-App-Registrierung nötig:
# Redirect-URI dort: https://north-flow.de/api/mail/callback ; Scopes: Mail.Send, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
